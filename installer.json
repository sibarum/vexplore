{
  "id": "vexplore",
  "name": "Vexplore",
  "publisher": "sibarum",
  "description": "A file explorer that suggests instead of asking.",
  "version": "0.1.2-SNAPSHOT",

  "repo": "sibarum/vexelray-dist",
  "branch": "main",
  "repoPath": "apps/vexplore",
  "releasesRepo": "sibarum/vexelray-dist",
  "tagFormat": "vexplore-v{version}",

  "windows": {
    "binaries": [
      {
        "name": "vexplore",
        "source": "vexplore/target/vexplore.exe",
        "icon": "vexplore/src/main/rc/vexplore.ico",
        "addToPath": true,
        "shortcuts": { "desktop": true, "startMenu": true, "label": "Vexplore" }
      },
      {
        "name": "vexplore-ffmpeg",
        "source": "vexplore/target/vexplore-ffmpeg-windows-x86_64.zip",
        "dir": "ffmpeg"
      },
      { "name": "notices", "source": "THIRD-PARTY-NOTICES.txt" }
    ]
  }
}
