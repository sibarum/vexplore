<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.sibarum</groupId>
    <artifactId>vexplore</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <name>vexplore</name>
    <description>
        A file explorer that suggests instead of asking.
    </description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <vexelray-framework.version>0.1.0-SNAPSHOT</vexelray-framework.version>
        <vexelray-gui.version>0.1.0-SNAPSHOT</vexelray-gui.version>
        <vexelray.version>0.1.0-SNAPSHOT</vexelray.version>
        <tactroller.version>1.0-SNAPSHOT</tactroller.version>
        <imagelib.version>0.1.0-SNAPSHOT</imagelib.version>
        <!-- imagelib's static library and the linker arguments beside it, staged by imagelib-wrapper's
             native/build.sh. Only the native image reads them; a JVM run extracts the DLL from the jar. -->
        <imagelib.static.dir>${project.basedir}/../imagelib-wrapper/native/dist/static/windows-x86_64</imagelib.static.dir>
        <junit.version>5.11.4</junit.version>

        <app.mainClass>dev.sibarum.vexplore.Vexplore</app.mainClass>

        <!--
          Program args for exec:exec, split on whitespace by the commandlineArgs form below. Empty is the
          interactive run; a multi-word value is several arguments rather than one, which is what lets
          an app.args of "capture out.png" mean what it says.
        -->
        <app.args></app.args>

        <!-- The automation driver: "off", "on" for the default port, or a port number. -->
        <automation>off</automation>

        <!--
          Two editions of the same code. The debug edition links the automation socket; the release edition does not
          contain it at all: -Pnative-release swaps the source root below for src/edition-release (a VexploreApp that
          names no AutomationStarter) and drops both automation dependencies from every classpath. Default (JVM,
          tests, exec:exec) = debug.
        -->
        <edition.src>src/edition-debug/java</edition.src>
        <automation.scope>compile</automation.scope>

        <!--
          Extra JVM flags for exec:exec, split on whitespace. Needed because a -D on the mvn command line sets a
          MAVEN property, which reaches the forked JVM only if the command line below names it: without this,
          "mvn exec:exec -Dmy.setting=48" runs the app with the default and reports a measurement of nothing.
        -->
        <app.jvmArgs></app.jvmArgs>
    </properties>

    <dependencies>
        <!-- The application framework: the edge this project would otherwise write for itself. Its -shell
             module brings vexelray-gui-core, -krono, -widget and tactroller with it, and owns the input
             backend, the clipboard, the window memory, the clock, the frame loop and the shutdown. -->
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-shell</artifactId>
            <version>${vexelray-framework.version}</version>
        </dependency>
        <!-- The driving socket, as a framework component. Its own module, so a binary that never wants to be
             driven does not link a listening socket. -->
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-automation</artifactId>
            <version>${vexelray-framework.version}</version>
            <scope>${automation.scope}</scope>
        </dependency>
        <!-- The widget shelf, and the framework core and draw modules behind it. Reached through -shell as
             well; named here because this project's own Ui builds against it directly. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-widget</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <!-- The native folder dialog, for the destination nobody suggested. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-nfd</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <!-- The clock. Motion enters at the application edge and nowhere else: -widget declares seams shaped
             out of JDK types and this module satisfies them, so a widget animates without naming Kronometer. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-krono</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <!-- Driving the running app the way a person does: real window, real Vulkan, real frame loop.
             A troubleshooting instrument, not a shipped feature - see vexelray-gui/docs/automation.md. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-automation</artifactId>
            <version>${vexelray-gui.version}</version>
            <scope>${automation.scope}</scope>
        </dependency>
        <!-- Input at the application edge: the tactroller->atchung bridge (brings tactroller-api and
             atchung-core transitively, which is where State and Committer come from). -->
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-atchung</artifactId>
            <version>${tactroller.version}</version>
        </dependency>
        <!-- Standalone OS clipboard; no input-subsystem coupling. -->
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-clipboard</artifactId>
            <version>${tactroller.version}</version>
        </dependency>
        <!-- Pixels from any image file (PNG, JPEG, GIF, WebP, SVG and the rest) as RGBA8 ready to upload: the
             Preview Dock's first tier. The GUI decodes nothing itself, by design. -->
        <dependency>
            <groupId>sibarum.imagelib</groupId>
            <artifactId>imagelib-wrapper</artifactId>
            <version>${imagelib.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.graalvm.buildtools</groupId>
                    <artifactId>native-maven-plugin</artifactId>
                    <version>0.10.6</version>
                    <executions>
                        <execution>
                            <id>build-native</id>
                            <goals><goal>compile-no-fork</goal></goals>
                            <phase>package</phase>
                        </execution>
                    </executions>
                    <configuration>
                        <imageName>${native.imageName}</imageName>
                        <mainClass>${app.mainClass}</mainClass>
                        <buildArgs>
                            <buildArg>--no-fallback</buildArg>
                            <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                            <buildArg>-H:+ForeignAPISupport</buildArg>
                            <!-- Raw input and the clipboard open an Arena.ofShared; without this the app runs and then throws on the way out. -->
                            <buildArg>-H:+SharedArenaSupport</buildArg>
                            <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                            <buildArg>-H:IncludeResources=META-INF/supirvast/shaders/.*</buildArg>
                            <buildArg>-H:IncludeResources=natives/.*</buildArg>
                            <!-- WINDOWS needs /ENTRY:mainCRTStartup as well: the linker would otherwise look for
                                 WinMain, and the image's entry is the C main. CONSOLE is the linker's default,
                                 spelled out so both editions pass the same two options. -->
                            <buildArg>-H:NativeLinkerOption=/SUBSYSTEM:${native.subsystem}</buildArg>
                            <buildArg>-H:NativeLinkerOption=/ENTRY:mainCRTStartup</buildArg>
                            <buildArg>-H:NativeLinkerOption=${project.build.directory}/vexplore.res</buildArg>
                            <!-- imagelib linked in rather than extracted: its loader finds the symbols in the
                                 executable and skips the DLL. The exports are what keep the linker from dropping a
                                 library nothing calls by name. They are imagelib-link.args (beside imagelib.lib)
                                 copied in: the plugin passes these arguments in an args file of its own, and
                                 native-image does not expand an @file named inside one. Copy it again when
                                 imagelib's header gains a function or rustc reports other system libraries. -->
                            <buildArg>-H:NativeLinkerOption=${imagelib.static.dir}/imagelib.lib</buildArg>
                            <buildArg>-H:NativeLinkerOption=/EXPORT:img_count</buildArg>
                            <buildArg>-H:NativeLinkerOption=/EXPORT:img_decode</buildArg>
                            <buildArg>-H:NativeLinkerOption=/EXPORT:img_delay_ms</buildArg>
                            <buildArg>-H:NativeLinkerOption=/EXPORT:img_free</buildArg>
                            <buildArg>-H:NativeLinkerOption=/EXPORT:img_height</buildArg>
                            <buildArg>-H:NativeLinkerOption=/EXPORT:img_last_error</buildArg>
                            <buildArg>-H:NativeLinkerOption=/EXPORT:img_pixels</buildArg>
                            <buildArg>-H:NativeLinkerOption=/EXPORT:img_probe</buildArg>
                            <buildArg>-H:NativeLinkerOption=/EXPORT:img_render_svg</buildArg>
                            <buildArg>-H:NativeLinkerOption=/EXPORT:img_svg_size</buildArg>
                            <buildArg>-H:NativeLinkerOption=/EXPORT:img_width</buildArg>
                            <buildArg>-H:NativeLinkerOption=kernel32.lib</buildArg>
                            <buildArg>-H:NativeLinkerOption=ntdll.lib</buildArg>
                            <buildArg>-H:NativeLinkerOption=userenv.lib</buildArg>
                            <buildArg>-H:NativeLinkerOption=ws2_32.lib</buildArg>
                            <buildArg>-H:NativeLinkerOption=dbghelp.lib</buildArg>
                        </buildArgs>
                    </configuration>
                </plugin>
                <!-- The executable's icon: a resource linked into the program, so it has to exist as a compiled .res
                     before link time. rc.exe is the Windows SDK's resource compiler and must be on PATH, as it is in a
                     Visual Studio developer prompt (which the native build already needs for link.exe). -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>3.1.0</version>
                    <executions>
                        <execution>
                            <id>compile-icon-resource</id>
                            <phase>prepare-package</phase>
                            <goals><goal>run</goal></goals>
                            <configuration>
                                <target>
                                    <exec executable="rc.exe" searchpath="true" failonerror="true">
                                        <arg value="/nologo"/>
                                        <arg value="/fo"/>
                                        <arg file="${project.build.directory}/vexplore.res"/>
                                        <arg file="${project.basedir}/src/main/rc/vexplore.rc"/>
                                    </exec>
                                </target>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- The edition's own sources (VexploreApp): src/edition-debug, or src/edition-release under -Pnative-release. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-edition-source</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration>
                            <sources><source>${edition.src}</source></sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <!-- The framework's annotation processor: what its vocabulary calls a compile error is
                         one. Named rather than found, because since JDK 23 javac runs no processor it merely
                         finds on the class path. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>dev.vexelray.framework</groupId>
                            <artifactId>vexelray-framework-processor</artifactId>
                            <version>${vexelray-framework.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <!--
              Run in a fresh JVM: mvn compile exec:exec
              exec:exec rather than exec:java so native access can be enabled for Panama FFM.

              One command line split on whitespace, rather than a list of argument elements. An argument
              element is exactly one token and a property cannot expand into several, so a multi-word
              app.args would arrive as a single argument. %classpath is substituted after the split, so it
              stays one argument even where a path contains a space.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <executable>${java.home}/bin/java</executable>
                    <classpathScope>runtime</classpathScope>
                    <commandlineArgs>--enable-native-access=ALL-UNNAMED -Dstdout.encoding=UTF-8 -Dautomation=${automation} ${app.jvmArgs} -classpath %classpath ${app.mainClass} ${app.args}</commandlineArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          GraalVM native images; both need a GraalVM JDK (JAVA_HOME) and are profile-gated because native-image
          takes minutes. Reachability metadata is under src/main/resources/META-INF/native-image/ (a stopgap: it
          belongs in the backend jars).

            mvn -Pnative-release package -DskipTests  ->  target/vexplore.exe        what ships and gets signed
            mvn -Pnative package -DskipTests          ->  target/vexplore-debug.exe  for ottermate

          release: Windows GUI subsystem (no console window ever) and no automation socket in the image.
          debug:   console subsystem (stdout is the `automation: localhost:<port>` protocol line) and automation.
          The plugins are declared once, in pluginManagement; the profiles only choose their inputs. Both run rc.exe
          for the icon (src/main/rc), so run them from a Visual Studio developer prompt.
        -->
        <profile>
            <id>native</id>
            <properties>
                <native.imageName>vexplore-debug</native.imageName>
                <native.subsystem>CONSOLE</native.subsystem>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <extensions>true</extensions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>native-release</id>
            <properties>
                <native.imageName>vexplore</native.imageName>
                <native.subsystem>WINDOWS</native.subsystem>
                <edition.src>src/edition-release/java</edition.src>
                <automation.scope>test</automation.scope>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <extensions>true</extensions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Build-time platform selection: exactly one activates from the host OS, adding VexelRay's
             matching provider module and tactroller's input backend (both found by ServiceLoader). -->
        <profile>
            <id>platform-windows</id>
            <activation><os><family>windows</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-windows</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-windows</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-linux</id>
            <activation><os><family>unix</family><name>linux</name></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-linux</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-linux</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-macos</id>
            <activation><os><family>mac</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-macos</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-macos</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
